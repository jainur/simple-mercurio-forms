{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase2/requirement-evaluation.schema.json",
  "title": "RequirementEvaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirement_id",
    "status",
    "confidence",
    "supporting_evidence",
    "missing_evidence",
    "conflicts",
    "citations",
    "recommended_action"
  ],
  "properties": {
    "requirement_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "SATISFIED",
        "PARTIALLY_SATISFIED",
        "MISSING",
        "CONFLICTING",
        "NEEDS_REVIEW"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "supporting_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommended_action": {
      "type": "string",
      "minLength": 1
    }
  }
}
