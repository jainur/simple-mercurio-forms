{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase2/eligibility-matrix.schema.json",
  "title": "EligibilityMatrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "procedure_id",
    "overall_confidence",
    "coverage_score",
    "requirements",
    "blockers",
    "next_actions"
  ],
  "properties": {
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "procedure_id": {
      "type": "string",
      "minLength": 1
    },
    "overall_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "coverage_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./requirement-evaluation.schema.json"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
