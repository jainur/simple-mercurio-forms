{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase2/procedure-ranking.schema.json",
  "title": "ProcedureRanking",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "ranked_procedures"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "ranked_procedures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "procedure_id",
          "readiness_score",
          "confidence",
          "top_blockers"
        ],
        "properties": {
          "procedure_id": {
            "type": "string",
            "minLength": 1
          },
          "readiness_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "top_blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
